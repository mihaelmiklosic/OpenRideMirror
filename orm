#!/bin/sh
set -eu

PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3 is missing. Install Python 3.11 or newer, then rerun this command." >&2
  exit 1
fi
if ! python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'; then
  echo "OpenRideMirror requires Python 3.11 or newer." >&2
  exit 1
fi

OPENRIDEMIRROR_ROOT="$PROJECT_DIR"
PYTHONPATH="$PROJECT_DIR/development/tools/src${PYTHONPATH:+:$PYTHONPATH}"
export OPENRIDEMIRROR_ROOT PYTHONPATH
exec python3 -m openridemirror_tools.cli "$@"
